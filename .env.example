# LLM provider: "gemini" (default) or "deepseek".
# DeepSeek needs DEEPSEEK_API_KEY; Gemini needs GEMINI_API_KEY.
# Note: DeepSeek has no native web-search grounding — the Google
# grounding fallback only runs under the gemini provider.
LLM_PROVIDER="deepseek"

# DEEPSEEK_API_KEY: Required when LLM_PROVIDER=deepseek.
# Get yours at https://platform.deepseek.com
DEEPSEEK_API_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TAVILY_API_KEY: Optional. Used as a high-fidelity live web sourcing engine.
# Tavily offers 1,000 free searches per month. Get yours at https://tavily.com
TAVILY_API_KEY=""

# APP_PASSCODE: Optional. When set, the /api/* endpoints require the
# x-app-passcode header to match. The frontend prompts visitors for it
# before running a search, so public traffic can't burn your API quota.
# Leave empty for open local dev.
APP_PASSCODE=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
